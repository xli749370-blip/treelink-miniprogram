/* ===========================================================================
平衡车控制页（2026-10-23 落地自 design/balance-car-preview.html 定稿）
换算口径：预览 1px → 2rpx（750 设计宽）；横屏用 vh/vw（rpx 按长边换算全是坑）。
配色：本页恒为个性1（深海蓝）。车控专用 token 就地定义（--bk-*）——
  与 app.wxss 的 --t-key-face/--t-key-cap 同值（2026-11-15 无人机页已并入同一套
  实体键配方），仍就地保留一份：本页部件全部走 --bk-*，不跨文件借 token。
背景纪律（2026-10-23 用户明令）：不要在背景上叠背景 ——
  页面渐变只画 .page 这一层；page 元素在 app.wxss 里是平色兜底；
  headlight 暖光 overlay 不算背景（是内容反馈层，透明度极低）。
=========================================================================== */
.page {
  /* 车控专用 token（预览 .phone 基础 token 同值） */
  --bk-txt: #dfe8f4;              /* 主文字 */
  --bk-steel: #8fa3bd;            /* 次级文字 / 刻度 */
  --bk-ok: #2e7fc4;               /* 常规蓝：已连接 / 速度弧 */
  --bk-ok-br: #3a94dd;
  --bk-run: #34c98e;              /* 绿 = 平衡已启动正常行驶（专用，不作他用） */
  --bk-run-br: #4fe0a8;
  --bk-danger: #e05a5a;           /* 红 = 倾角超限 / 拒绝 */
  --bk-amber: #e0a84a;            /* 琥珀 = 灯光开启 */
  --bk-key-face: #16283f;         /* 键面 */
  --bk-key-cap: #05090f;          /* 键帽侧壁（实心） */
  --bk-key-edge: rgba(255, 255, 255, 0.14);
  --bk-panel: rgba(22, 40, 63, 0.72);
  --bk-shade-out: rgba(0, 0, 0, 0.45);

  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  overflow: hidden;
  /* 页面背景：延用平衡车预览的上亮下暗三段纵向渐变（token 见 app.wxss，单层绘制） */
  background: linear-gradient(180deg, var(--t-bg-hi) 0%, var(--t-bg-md) 52%, var(--t-bg-lo) 100%);
  color: var(--bk-txt);
}
/* ---------- 个性皮肤（2026-10-24 补齐，与预览 .phone.t2/.t3 同值）----------
   背景三段渐变的 T2/T3 换档由 app.wxss 的 .page.theme-2/3 自动生效（--t-bg-*）；
   这里只换车控部件 token。canvas 侧（速度弧底弧色）见 balance.js _drawArc。 */
.page.theme-2 {
  --bk-key-face: #221d3e;
  --bk-panel: rgba(34, 29, 62, 0.72);
}
.page.theme-3 {
  --bk-txt: #22314a;
  --bk-steel: #5c6f8c;
  --bk-key-face: #f6f9fd;
  --bk-key-cap: #93a5c0;
  --bk-panel: rgba(255, 255, 255, 0.8);
  --bk-shade-out: rgba(80, 100, 140, 0.35);
  --bk-key-edge: rgba(30, 50, 90, 0.18);
}
/* T3 冰川：深底部件反转（预览同款 + 玻璃泡中央刻度加深保可读） */
.page.theme-3 .bubble-glass { background: rgba(230, 240, 250, 0.7); border-color: rgba(40, 70, 120, 0.25); }
.page.theme-3 .bubble {
  background: radial-gradient(circle at 38% 32%, #ffffff, rgba(90, 150, 230, .5) 55%, rgba(60, 110, 200, .15) 80%, transparent 85%);
  box-shadow: 0 0 20rpx 4rpx rgba(90, 150, 230, .25);
}
.page.theme-3 .glass-mark { border-left-color: rgba(40, 70, 120, .55); box-shadow: 6rpx 0 0 rgba(40, 70, 120, .28); }
.page.theme-3 .stick-cap {
  box-shadow: 0 10rpx 0 #0b1526, 0 16rpx 32rpx rgba(50, 75, 120, .30),
              inset 0 0 0 2rpx rgba(255, 255, 255, .16), inset 0 4rpx 8rpx rgba(255, 255, 255, .12);
}
.page.theme-3 .stick-cap.grab {
  box-shadow: 0 4rpx 0 #0b1526, 0 6rpx 12rpx rgba(50, 75, 120, .30),
              inset 0 0 0 2rpx rgba(255, 255, 255, .22), inset 0 4rpx 8rpx rgba(255, 255, 255, .18);
}
/* T3 键面近白 → 白扫光不可见，换冷调钢蓝高光（预览同款） */
.page.theme-3 .main-key .scan {
  background: linear-gradient(100deg, transparent, rgba(88, 132, 204, .10) 30%,
             rgba(88, 132, 204, .22) 50%, rgba(88, 132, 204, .10) 70%, transparent);
}
.page.theme-3 .homebar { background: rgba(30, 50, 90, 0.3); }
.page.theme-3 .speed .num { text-shadow: 0 0 36rpx rgba(58, 148, 221, .22); }
/* 内容定位层：绝对定位容器的基准（top 由 JS 按胶囊高度写入，避让自定义导航） */
.body { position: absolute; left: 0; right: 0; bottom: 0; }

/* 到达长入：与预览交棒配方一致（scale .96→1 过冲曲线，底层不淡入） */
.page-enter { animation: lyr-enter .42s cubic-bezier(.3, 1.42, .55, 1) both; }
@keyframes lyr-enter { from { transform: scale(.96); } to { transform: scale(1); } }

/* 横竖屏切换瞬间：全屏斜向扫光盖掉"啪"地跳变（同无人机页配方） */
.page.flip::after {
  content: ""; position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  pointer-events: none; z-index: 9;
  background: linear-gradient(104deg,
    transparent 26%,
    rgba(140, 190, 255, 0.1) 42%,
    rgba(206, 233, 255, 0.46) 50%,
    rgba(140, 190, 255, 0.1) 58%,
    transparent 74%);
  transform: translateX(-125%); opacity: 0;
}
.page.flip::after { animation: pk-screen-flip .55s cubic-bezier(.3, .65, .3, 1); }
@keyframes pk-screen-flip {
  0%   { transform: translateX(-125%); opacity: 0; }
  30%  { opacity: 1; }
  100% { transform: translateX(125%); opacity: 0; }
}

/* ---------- 灯光暖光 overlay ---------- */
.headlight {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  pointer-events: none; opacity: 0; transition: opacity .5s;
  background: radial-gradient(60% 30% at 50% 100%, rgba(224, 190, 120, .14), transparent 75%);
}
.headlight.on { opacity: 1; }

/* ---------- 顶部状态行 ---------- */
.top {
  position: absolute; left: 36rpx; right: 36rpx; top: 32rpx; height: 80rpx;
  display: flex; align-items: center; justify-content: space-between;
}
.top-g { display: flex; align-items: center; }   /* 已连接 + 切换键贴邻成组 */
.pill {
  display: flex; align-items: center; gap: 14rpx; height: 60rpx;
  padding: 0 26rpx; border-radius: 99rpx;
  background: var(--bk-panel); font-size: 24rpx; color: var(--bk-txt);
  box-shadow: inset 0 0 0 2rpx var(--bk-key-edge);
  transition: transform .06s ease, box-shadow .06s ease;
}
.pill.btn-down { transform: translateY(4rpx); opacity: .85; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--bk-ok-br); animation: dot-breathe 2s ease-in-out infinite; }
@keyframes dot-breathe { 0%, 100% { opacity: .45; } 50% { opacity: 1; } }  /* ≥2s = 系统在跑 */
.pill.connecting .dot { animation-duration: .5s; background: var(--bk-amber); }
/* 横竖屏切换键（页面内 utility 键）：手机轮廓图标，纯 CSS 随方向转 90° */
.or-btn {
  width: 68rpx; height: 68rpx; border-radius: 50%; margin-left: 16rpx; flex: 0 0 auto;
  background: var(--bk-panel); color: var(--bk-steel);
  box-shadow: inset 0 0 0 2rpx var(--bk-key-edge);
  display: flex; align-items: center; justify-content: center;
  transition: color .2s ease, transform .06s ease;
}
.or-btn.btn-down { transform: scale(.94); }
.or-ico {
  position: relative; width: 22rpx; height: 32rpx;
  border: 3rpx solid currentColor; border-radius: 6rpx;
  transition: transform .3s cubic-bezier(.3, 1.42, .55, 1);  /* 过冲弹一下，仪表同配方 */
}
.or-ico::after {
  content: ""; position: absolute; left: 50%; bottom: 3rpx; width: 8rpx; height: 3rpx;
  margin-left: -4rpx; background: currentColor; border-radius: 1rpx;
}
.page.land .or-ico { transform: rotate(90deg); }
/* 个性键（圆形小键，个性1→2→3 循环；「个性」小字 + 当前档号） */
.persona-key {
  width: 68rpx; height: 68rpx; border-radius: 50%; margin-left: 12rpx; flex: 0 0 auto;
  background: var(--bk-panel); color: var(--bk-txt);
  box-shadow: inset 0 0 0 2rpx var(--bk-key-edge);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx;
  transition: transform .06s ease, box-shadow .06s ease;
}
.persona-key.btn-down { transform: scale(.94); }
.pk-cap { font-size: 15rpx; line-height: 1; color: var(--bk-steel); letter-spacing: 1rpx; }
.pk-n { font-size: 26rpx; line-height: 1; font-weight: 600; font-variant-numeric: tabular-nums; }
/* IP / 端口输入（未连接时显示在右侧）——宽度给顶行个性键让位（2026-10-24） */
.ip, .port {
  height: 60rpx; border-radius: 99rpx; margin-left: 16rpx;
  background: var(--bk-panel); color: var(--bk-txt); font-size: 24rpx;
  padding: 0 24rpx; box-shadow: inset 0 0 0 2rpx var(--bk-key-edge);
}
.ip { width: 216rpx; }
.port { width: 104rpx; }
/* 电量胶囊 */
.batt { gap: 14rpx; }
.batt-case {
  width: 44rpx; height: 22rpx; border: 3rpx solid var(--bk-steel);
  border-radius: 6rpx; position: relative; box-sizing: border-box;
}
.batt-case .batt-fill { position: absolute; left: 3rpx; top: 3rpx; bottom: 3rpx; width: 70%; background: var(--bk-run); border-radius: 1rpx; }

/* ---------- 中央仪表盘 ---------- */
.dial {
  position: absolute; left: 50%; top: 156rpx; transform: translateX(-50%);
  width: 516rpx; height: 516rpx; border-radius: 50%;
}
.dial-cv { position: absolute; left: 0; top: 0; right: 0; bottom: 0; width: 100%; height: 100%; }
/* 玻璃泡管（前后倾角，±12° 映射 ±74px 内部位移，位移量由 JS 按实测尺寸算） */
.bubble-glass {
  position: absolute; left: 50%; top: 88rpx; transform: translateX(-50%);
  width: 344rpx; height: 32rpx; border-radius: 99rpx;
  background: rgba(8, 14, 26, .55); border: 2rpx solid rgba(150, 180, 220, .28);
  box-sizing: border-box; overflow: hidden;
}
/* 中央刻度：双竖线 = 0°（水平） */
.glass-mark {
  position: absolute; left: 50%; top: 4rpx; bottom: 4rpx; width: 0;
  border-left: 4rpx solid rgba(220, 235, 255, .75); transform: translateX(-6rpx);
  box-shadow: 6rpx 0 0 rgba(220, 235, 255, .4);
}
/* 泡：跟随 pitch（transform 由 JS 逐帧写入） */
.bubble {
  position: absolute; top: 50%; left: 50%; width: 48rpx; height: 48rpx; border-radius: 50%;
  margin: -24rpx 0 0 -24rpx;
  background: radial-gradient(circle at 38% 32%, rgba(235, 248, 255, .95), rgba(140, 200, 255, .55) 55%, rgba(90, 160, 240, .18) 78%, transparent 82%);
  box-shadow: 0 0 20rpx 4rpx rgba(140, 205, 255, .35);
}
/* 泡超限变红（倾角 >10°） */
.bubble.over {
  background: radial-gradient(circle at 38% 32%, #ffd9d9, rgba(224, 90, 90, .6) 55%, rgba(200, 60, 60, .2) 80%, transparent 85%);
  box-shadow: 0 0 24rpx 6rpx rgba(224, 90, 90, .45);
}
/* 速度读数 */
.speed { position: absolute; left: 50%; top: 224rpx; transform: translateX(-50%); text-align: center; width: 400rpx; }
.speed .num {
  font-size: 104rpx; font-weight: 600; line-height: 1; letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 36rpx rgba(58, 148, 221, .35);
  transition: text-shadow .3s;
}
.speed .num.is-run { text-shadow: 0 0 36rpx rgba(79, 224, 168, .35); }
.speed .unit { font-size: 24rpx; color: var(--bk-steel); letter-spacing: 4rpx; margin-top: 6rpx; }
/* 平衡状态字（运行态：绿 + 2s 呼吸 = 系统在跑） */
.bal-state {
  position: absolute; left: 50%; top: 392rpx; transform: translateX(-50%);
  font-size: 26rpx; color: var(--bk-steel); letter-spacing: 2rpx; white-space: nowrap;
  transition: color .3s;
}
.bal-state.is-run { color: var(--bk-run); animation: dot-breathe 2s ease-in-out infinite; }
/* 倾角读数 */
.tilt-read {
  position: absolute; left: 50%; top: 444rpx; transform: translateX(-50%);
  font-size: 22rpx; color: var(--bk-steel); font-variant-numeric: tabular-nums; letter-spacing: 1rpx;
}
.tilt-read.over { color: var(--bk-danger); }

/* ---------- 功能键行（灯光 / 档位 / 鸣笛） ----------
   配方 = 无人机槽键：位移=键帽厚度、均匀内环白边、光效全在真节点。
   2026-10-24 纵向重排（修复与主键/摇杆的顶入冲突）：功能键上移 12rpx、
   键高 96→88rpx、间距 32→24rpx —— padTop 大的机型（刘海屏）也放得下 */
.feat { position: absolute; left: 50%; top: 680rpx; transform: translateX(-50%); display: flex; gap: 24rpx; }
.key {
  width: 140rpx; height: 88rpx; border-radius: 24rpx; position: relative;
  background: var(--bk-key-face); color: var(--bk-txt);
  font-size: 24rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx;
  box-shadow: 0 8rpx 0 var(--bk-key-cap), 0 12rpx 24rpx var(--bk-shade-out),
              inset 0 0 0 2rpx var(--bk-key-edge), inset 0 0 0 4rpx rgba(255, 255, 255, .06);
  transition: transform .06s ease, box-shadow .06s ease;
}
.key.btn-down { transform: translateY(8rpx);
  box-shadow: 0 0 0 var(--bk-key-cap), 0 4rpx 8rpx var(--bk-shade-out),
              inset 0 0 0 2rpx var(--bk-key-edge), inset 0 0 0 4rpx rgba(255, 255, 255, .06); }
.k-lbl { line-height: 1; font-variant-numeric: tabular-nums; }
/* 图标底座 30rpx + currentColor（无人机 .ico 配方；全部真实节点 —— 真机不渲染伪元素动画） */
.k-ico { position: relative; width: 30rpx; height: 30rpx; }
/* 灯光图标：灯壳 + 光束 */
.lt-body { position: absolute; left: 4rpx; top: 6rpx; width: 18rpx; height: 18rpx;
  border-radius: 50% 50% 45% 45%; background: currentColor; opacity: .85; }
.lt-beam { position: absolute; right: 0; top: 10rpx; width: 8rpx; height: 10rpx;
  background: linear-gradient(90deg, currentColor, transparent); opacity: .3; border-radius: 2rpx; }
.key.light-on { color: var(--bk-amber); }
.key.light-on .lt-beam { opacity: .95; box-shadow: 0 0 12rpx 2rpx rgba(224, 168, 74, .6); }
/* 档位图标：表针弧（表针是真实节点，转角由 JS 写 inline transform） */
.gg-ring { position: absolute; inset: 2rpx; border: 3rpx solid currentColor; border-radius: 50%; opacity: .6; }
.gg-needle { position: absolute; left: 50%; top: 50%; width: 3rpx; height: 12rpx;
  background: currentColor; border-radius: 1rpx; transform-origin: 50% 100%; }
/* 喇叭图标（2026-10-24 第六版：矩形壳 + overflow 裁切的旋转正方形锥）。
   根因复盘：border 三角（v1 夹高被展开 / v2 半像素吸附）与 clip-path
   （v3 两盒 / v4 单盒）连败四轮，而同页灯光（纯矩形）、档位（圆环 +
   transform rotate 表针）真机一直正常 —— 该 webview 对"三角类构形"
   （border 三角、clip-path）整体不可靠，已验证可靠的原语是矩形 / 圆角 /
   overflow 裁切 / transform rotate。v6 锥体 = 10×20 overflow:hidden 盒内
   放 14.2×14.2 正方形转 45°（对角线 ≈20，顶点恰落盒上/下/右角），只露出
   右半 = 平滑右指三角（外形与 v0 设计一致：锥 20 高 vs 壳 14 高）；
   盒中心 = 图标中心 15rpx，壳 8..22 同心，壳锥相对位置由同一套盒模型
   保证。鸣笛前推动画挂在 .hn-c。 */
.hn-body { position: absolute; left: 5rpx; top: 8rpx; width: 10rpx; height: 14rpx;
  background: currentColor; border-radius: 2rpx; }
.hn-c { position: absolute; left: 15rpx; top: 5rpx; width: 10rpx; height: 20rpx; overflow: hidden; }
.hn-rot { position: absolute; left: -7.1rpx; top: 2.9rpx; width: 14.2rpx; height: 14.2rpx;
  background: currentColor; transform: rotate(45deg); }
.key.horn.honk .hn-c { animation: horn-wave .6s ease-out; }
@keyframes horn-wave { 0% { transform: translateX(0); } 40% { transform: translateX(6rpx); } 100% { transform: translateX(0); } }

/* 外扩 / 内收环（无人机 .fx-ring 配方：真实节点、absolute、opacity 收尾归零） */
.fx-ring {
  position: absolute; left: -8rpx; top: -8rpx; right: -8rpx; bottom: -8rpx;
  border-radius: 28rpx; border: 4rpx solid var(--bc, var(--bk-run-br));
  opacity: 0; display: none; pointer-events: none;
}
.fx-ring.burst { display: block; animation: pk-fx-out .6s cubic-bezier(.2, .7, .3, 1); }
.fx-ring.suck  { display: block; animation: pk-fx-in  .6s cubic-bezier(.2, .7, .3, 1); }
@keyframes pk-fx-out { 0% { transform: scale(1); opacity: .9; } 100% { transform: scale(1.24); opacity: 0; } }
@keyframes pk-fx-in  { 0% { transform: scale(1.24); opacity: .8; } 72% { transform: scale(1.04); opacity: .4; } 100% { transform: scale(1); opacity: 0; } }

/* ---------- 行驶摇杆（配方同无人机页 2026-10-23 版：碗面 + 深蓝胶帽） ---------- */
.stick {
  position: absolute; left: 68rpx; bottom: 180rpx;
  width: 256rpx; height: 256rpx; border-radius: 50%;
  background: radial-gradient(circle at 50% 34%, rgba(70, 110, 165, .28), rgba(10, 18, 32, .55) 70%);
  box-shadow: inset 0 0 0 2rpx var(--bk-key-edge), inset 0 12rpx 36rpx rgba(0, 0, 0, .4);
}
.stick-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 1; touch-action: none; }
.stick-knob {
  position: absolute; left: 50%; top: 50%;
  width: 116rpx; height: 116rpx; margin-left: -58rpx; margin-top: -58rpx;
  pointer-events: none; will-change: transform; transform: translate3d(0, 0, 0);
}
.stick-cap {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-radius: 50%;
  background: radial-gradient(circle at 42% 30%, #35507a, #1a2c48 62%, #122036);
  box-shadow: 0 10rpx 0 #05090f, 0 16rpx 32rpx rgba(0, 0, 0, .5),
              inset 0 0 0 2rpx rgba(255, 255, 255, .16), inset 0 4rpx 8rpx rgba(255, 255, 255, .12);
  display: flex; align-items: center; justify-content: center;
  transition: box-shadow .06s ease;
}
/* 帽心高光点（真实节点） */
.cap-dot { width: 36rpx; height: 36rpx; border-radius: 50%;
  background: radial-gradient(circle at 40% 32%, rgba(160, 205, 255, .5), rgba(90, 150, 240, .12) 70%, transparent 80%); }
/* 按住（grab）：帽子下沉 —— 侧壁收短、投影收窄、内圈白边提亮 */
.stick-cap.grab {
  box-shadow: 0 4rpx 0 #05090f, 0 6rpx 12rpx rgba(0, 0, 0, .5),
              inset 0 0 0 2rpx rgba(255, 255, 255, .22), inset 0 4rpx 8rpx rgba(255, 255, 255, .18);
}
/* 摇杆方向微光（推杆方向亮起：radial 光斑） */
.stick-hint, .stick-hint2 { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-radius: 50%; opacity: 0; transition: opacity .3s; pointer-events: none; }
.stick-hint  { background: radial-gradient(30% 22% at 50% 12%, rgba(120, 185, 255, .28), transparent 75%); }
.stick-hint2 { background: radial-gradient(30% 22% at 50% 88%, rgba(120, 185, 255, .22), transparent 75%); }
.stick.fwd  .stick-hint  { opacity: 1; }
.stick.back .stick-hint2 { opacity: 1; }
.stick-name {
  /* 中心锚定摇杆中轴（left = 圆心 68+128=196rpx），盒子收缩到内容宽后
     translateX(-50%) 归中 —— 旧写法 width 256rpx 装不下这行字，nowrap 溢出后
     text-align 的溢出方向随渲染器漂移，真机上读作"没对齐"。横竖屏同配方。 */
  position: absolute; left: 196rpx; bottom: 136rpx; transform: translateX(-50%);
  padding-left: 2rpx;   /* 抵消 letter-spacing 行尾空隙：盒宽含尾隙 → 字形左偏半隙 */
  font-size: 21rpx; color: var(--bk-steel); letter-spacing: 2rpx; white-space: nowrap;
}

/* ---------- 平衡主键 ---------- */
.main-key {
  position: absolute; right: 88rpx; bottom: 200rpx;
  width: 192rpx; height: 192rpx; border-radius: 50%;
  background: var(--bk-key-face); color: var(--bk-txt);
  box-shadow: 0 8rpx 0 var(--bk-key-cap), 0 16rpx 36rpx var(--bk-shade-out),
              inset 0 0 0 2rpx var(--bk-key-edge), inset 0 0 0 4rpx rgba(255, 255, 255, .07);
  transition: transform .06s ease, box-shadow .06s ease;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx;
  overflow: hidden;   /* 扫光带裁切 */
}
.main-key.btn-down { transform: translateY(8rpx);
  box-shadow: 0 0 0 var(--bk-key-cap), 0 6rpx 12rpx var(--bk-shade-out),
              inset 0 0 0 2rpx var(--bk-key-edge), inset 0 0 0 4rpx rgba(255, 255, 255, .07); }
/* 均匀内环白边 + 顶部单光源淡渐变（无人机白边修正配方）—— 走真实节点 */
.mk-face {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-radius: 50%; pointer-events: none;
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, .16);
  background: linear-gradient(180deg, rgba(255, 255, 255, .10), rgba(255, 255, 255, 0) 42%);
}
/* idle 扫光（2026-10-23 定稿配方：transform 位移带，弃 background-position 方案）
   独立光带节点 skewX 斜切匀速平移，起止点都藏在键外（键 overflow:hidden 裁切）
   —— 接缝发生在不可见处，光带 ~86% 时间可见，循环无跳变 */
.main-key .scan {
  position: absolute; top: -12%; bottom: -12%; left: 0; width: 45%; pointer-events: none;
  transform: translateX(-190%) skewX(-18deg);
  background: linear-gradient(100deg, transparent, rgba(255, 255, 255, .06) 30%,
             rgba(255, 255, 255, .17) 50%, rgba(255, 255, 255, .06) 70%, transparent);
  animation: mk-scan 2.6s linear infinite;
}
@keyframes mk-scan {
  0%   { transform: translateX(-190%) skewX(-18deg); }
  100% { transform: translateX(250%) skewX(-18deg); }
}
/* 平衡图标：陀螺环 + 中轴 + 轮弧（真实节点） */
.mk-ico { position: relative; width: 60rpx; height: 60rpx; }
.mk-ico .ring { position: absolute; left: 6rpx; top: 6rpx; right: 6rpx; height: 36rpx;
  border: 4rpx solid currentColor; border-radius: 50%; }
.mk-ico .axis { position: absolute; left: 50%; top: 14rpx; bottom: 24rpx; width: 4rpx; margin-left: -2rpx;
  background: currentColor; border-radius: 2rpx; }
.mk-ico .wheel { position: absolute; left: 14rpx; bottom: 4rpx; width: 32rpx; height: 12rpx;
  border-bottom: 5rpx solid currentColor; border-radius: 0 0 20rpx 20rpx; }
.main-key .mk-lbl { font-size: 22rpx; line-height: 1.25; text-align: center; white-space: nowrap; }
/* 运行态：绿键面 + 图标环慢旋（≥2s 系统在跑档） */
.main-key.running { background: linear-gradient(180deg, #1f7a58, #14563e); color: #eafff5;
  animation: mk-breathe 2s ease-in-out infinite; }
.main-key.running .mk-ico .ring { border-top-color: rgba(255, 255, 255, .35); animation: mk-spin 2s linear infinite; }
.main-key.running .scan { display: none; }
@keyframes mk-breathe { 0%, 100% { filter: brightness(.92); } 50% { filter: brightness(1.12); } }
@keyframes mk-spin { to { transform: rotate(360deg); } }
/* 拒绝反馈：零位移红框闪烁（无人机 pk-to-refuse 配方 —— shake 已判死刑） */
.main-key.to-refuse { animation: pk-refuse .5s ease-out; }
@keyframes pk-refuse {
  0%, 42%  { box-shadow: 0 8rpx 0 var(--bk-key-cap), 0 16rpx 36rpx var(--bk-shade-out), inset 0 0 0 5rpx rgba(224, 90, 90, .95); }
  20%, 62% { box-shadow: 0 8rpx 0 var(--bk-key-cap), 0 16rpx 36rpx var(--bk-shade-out), inset 0 0 0 5rpx rgba(224, 90, 90, .25); }
  100%     { box-shadow: 0 8rpx 0 var(--bk-key-cap), 0 16rpx 36rpx var(--bk-shade-out), inset 0 0 0 5rpx rgba(224, 90, 90, 0); }
}
.main-key .fx-ring { border-radius: 50%; }
/* 主键外扩/内收环颜色：启动 = 绿；关闭 = 钢蓝（收拢读作"交回控制权"） */
.main-key .fx-ring.burst { --bc: var(--bk-run-br); }
.main-key .fx-ring.suck  { --bc: var(--bk-ok-br); }
.main-key-name {
  position: absolute; right: 88rpx; bottom: 144rpx; width: 192rpx; text-align: center;
  font-size: 21rpx; color: var(--bk-steel); letter-spacing: 4rpx;
}

/* ---------- 遥测行 / home 条 ---------- */
.telemetry {
  position: absolute; left: 36rpx; right: 36rpx; bottom: 64rpx; text-align: center;
  font-size: 23rpx; color: var(--bk-steel); font-variant-numeric: tabular-nums; letter-spacing: 1rpx;
  white-space: nowrap; overflow: hidden;
}
.homebar {
  position: absolute; left: 50%; bottom: 16rpx; transform: translateX(-50%);
  width: 240rpx; height: 8rpx; border-radius: 4rpx; background: rgba(255, 255, 255, .22);
}


/* ============================================================
   横屏操控态（812×375 → vh/vw）：可操控部分为主体 ——
   大摇杆(40vh) / 大主键(27.7vh)+功能键竖列在右，仪表盘缩为居中陪衬(scale .58)
   换算口径：纵向/尺寸 = 预览px ÷ 375 × 100vh；横向位置 = 预览px ÷ 812 × 100vw。
   级联纪律：.page.land 覆盖块放样式表末尾（同特异性覆盖必须靠后或升特异性）
   ============================================================ */
.page.land .body .top { left: 2vw; right: 2vw; top: 2.1vh; height: 8.5vh; justify-content: flex-start; }
/* 2026-10-24 按键冲突修复：右列（ip/port/电量）收到左组 —— 横屏右上角是
   微信胶囊按钮的地盘，原先 space-between 会把输入/电量顶进去；
   功能键列同时改底部锚定（与 padTop 解耦），竖列再也不会压到主键与主键名 */
.page.land .body .batt { margin-left: 2vh; }
.page.land .body .pill { height: 6.9vh; font-size: 2.9vh; padding: 0 2.9vh; gap: 1.3vh; }
.page.land .body .dot { width: 1.9vh; height: 1.9vh; }
.page.land .body .or-btn { width: 9vh; height: 9vh; margin-left: 2vh; }
.page.land .body .persona-key { width: 9vh; height: 9vh; margin-left: 2vh; gap: 0.4vh; }
.page.land .body .pk-cap { font-size: 2.2vh; }
.page.land .body .pk-n { font-size: 3.4vh; }
.page.land .body .or-ico { width: 2.9vh; height: 4.3vh; border-width: 0.4vh; border-radius: 0.8vh; }
.page.land .body .or-ico::after { width: 1.1vh; height: 0.4vh; margin-left: -0.55vh; bottom: 0.4vh; }
.page.land .body .ip, .page.land .body .port { height: 6.9vh; font-size: 2.9vh; margin-left: 2vh; }
.page.land .body .ip { width: 30vh; }
.page.land .body .port { width: 16vh; }
.page.land .body .batt-case { width: 5.9vh; height: 2.9vh; border-width: 0.4vh; border-radius: 0.8vh; }
/* 仪表盘：缩为陪衬，中心略上移。dial 与其子元素的定位都要换 vh ——
   rpx 在横屏按长边换算（×1.083），子元素会整体放大并错位 */
.page.land .body .dial { top: 50.75%; transform: translate(-50%, -50%) scale(.78); width: 68.8vh; height: 68.8vh; }
.page.land .body .bubble-glass { top: 11.7vh; width: 45.9vh; height: 4.3vh; border-width: 0.5vh; }
.page.land .body .glass-mark { top: 0.5vh; bottom: 0.5vh; border-left-width: 0.5vh; transform: translateX(-1.6vh); box-shadow: 1.6vh 0 0 rgba(220, 235, 255, .4); }
.page.land .body .bubble { width: 6.4vh; height: 6.4vh; margin: -3.2vh 0 0 -3.2vh; }
.page.land .body .speed { top: 29.9vh; width: 53.4vh; }
.page.land .body .speed .num { font-size: 13.9vh; letter-spacing: -0.5vh; text-shadow: 0 0 9.6vh rgba(58, 148, 221, .35); }
.page.land .body .speed .num.is-run { text-shadow: 0 0 9.6vh rgba(79, 224, 168, .35); }
.page.land .body .speed .unit { font-size: 3.2vh; letter-spacing: 1vh; margin-top: 1.6vh; }
.page.land .body .bal-state { top: 52.3vh; font-size: 3.5vh; letter-spacing: 0.5vh; }
.page.land .body .tilt-read { top: 59.2vh; font-size: 2.9vh; }
/* 功能键：主键上方竖列（右手拇指可达域）。底部锚定（bottom 42.5vh：
   主键顶 35.7vh + 名字 ≈39.7vh 之上），与 padTop 完全解耦 ——
   2026-10-24 修复：原 top 13.9vh 是顶锚，padTop 一大竖列就压进主键/主键名 */
.page.land .body .feat { left: auto; top: auto; bottom: 42.5vh; right: 10.1vw; transform: none; flex-direction: column; gap: 2.7vh; align-items: center; }
.page.land .body .key { width: 16.5vh; height: 11.7vh; border-radius: 3.2vh; font-size: 3.1vh; gap: 1vh;
  box-shadow: 0 2.1vh 0 var(--bk-key-cap), 0 3.2vh 6.4vh var(--bk-shade-out),
              inset 0 0 0 0.5vh var(--bk-key-edge), inset 0 0 0 1vh rgba(255, 255, 255, .06); }
.page.land .body .key.btn-down { transform: translateY(2.1vh);
  box-shadow: 0 0 0 var(--bk-key-cap), 0 1.1vh 2.1vh var(--bk-shade-out),
              inset 0 0 0 0.5vh var(--bk-key-edge), inset 0 0 0 1vh rgba(255, 255, 255, .06); }
.page.land .body .k-ico { transform: scale(.87); }
.page.land .body .fx-ring { border-radius: 3.2vh; border-width: 0.6vh; left: -1.1vh; top: -1.1vh; right: -1.1vh; bottom: -1.1vh; }
/* 主键：横屏主体之一（图标注册尺寸随 27.7vh 键体同比放大） */
.page.land .body .main-key { right: 7.5vw; bottom: 8vh; width: 27.7vh; height: 27.7vh; gap: 1vh;
  box-shadow: 0 2.1vh 0 var(--bk-key-cap), 0 4.3vh 9.6vh var(--bk-shade-out),
              inset 0 0 0 0.5vh var(--bk-key-edge), inset 0 0 0 1vh rgba(255, 255, 255, .07); }
.page.land .body .main-key.btn-down { transform: translateY(2.1vh);
  box-shadow: 0 0 0 var(--bk-key-cap), 0 1.6vh 3.2vh var(--bk-shade-out),
              inset 0 0 0 0.5vh var(--bk-key-edge), inset 0 0 0 1vh rgba(255, 255, 255, .07); }
.page.land .body .main-key .mk-face { box-shadow: inset 0 0 0 1vh rgba(255, 255, 255, .16); }
.page.land .body .main-key .mk-lbl { font-size: 2.9vh; }
.page.land .body .main-key .mk-ico { width: 16vh; height: 16vh; }
.page.land .body .main-key .mk-ico .ring { left: 1.6vh; top: 1.6vh; right: 1.6vh; height: 9.6vh; border-width: 1.1vh; }
.page.land .body .main-key .mk-ico .axis { top: 3.7vh; bottom: 6.4vh; width: 1.1vh; margin-left: -0.55vh; border-radius: 0.5vh; }
.page.land .body .main-key .mk-ico .wheel { left: 3.7vh; bottom: 1.1vh; width: 8.5vh; height: 3.2vh; border-bottom-width: 1.3vh; border-radius: 0 0 5.3vh 5.3vh; }
.page.land .body .main-key-name { right: 7.5vw; bottom: 36.8vh; width: 27.7vh; font-size: 2.7vh; letter-spacing: 0.5vh; }
/* 摇杆：横屏第一主体，40vh，帽径同步放大（阴影随 150px 基圆同比换 vh） */
.page.land .body .stick { left: 7vw; bottom: 9vh; width: 40vh; height: 40vh;
  box-shadow: inset 0 0 0 0.5vh var(--bk-key-edge), inset 0 1.9vh 5.6vh rgba(0, 0, 0, .4); }
.page.land .body .stick-knob { width: 17vh; height: 17vh; margin-left: -8.5vh; margin-top: -8.5vh; }
.page.land .body .stick-cap { box-shadow: 0 1.5vh 0 #05090f, 0 2.4vh 4.7vh rgba(0, 0, 0, .5),
  inset 0 0 0 0.5vh rgba(255, 255, 255, .16), inset 0 0.6vh 1.2vh rgba(255, 255, 255, .12); }
.page.land .body .stick-cap.grab { box-shadow: 0 0.6vh 0 #05090f, 0 0.9vh 1.8vh rgba(0, 0, 0, .5),
  inset 0 0 0 0.5vh rgba(255, 255, 255, .22), inset 0 0.6vh 1.2vh rgba(255, 255, 255, .18); }
.page.land .body .cap-dot { width: 5.3vh; height: 5.3vh; }
.page.land .body .stick-name { left: calc(7vw + 20vh); bottom: 50.4vh; transform: translateX(-50%); padding-left: 0.6vh; font-size: 2.7vh; letter-spacing: 0.6vh; }
/* 遥测与 home 条压扁 */
.page.land .body .telemetry { bottom: 2.7vh; font-size: 2.8vh; }
.page.land .body .homebar { width: 25.6vh; height: 0.8vh; bottom: 1.1vh; }
